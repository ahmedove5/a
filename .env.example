# Security: callers must send header  X-Alert-Token: <value>  (or ?token=<value>)
INGEST_TOKEN=change-me
DB_PATH=orders.db

# Alert if an order is received but not acknowledged by the store/POS within N minutes
ACK_TIMEOUT_MINUTES=5
WATCHDOG_INTERVAL_SECONDS=30
ALERT_ON_CANCEL=false

# Telegram: create a bot with @BotFather, add it to your group, get chat id (group ids start with -100)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Email (Gmail: smtp.gmail.com + an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Email inbox watcher: forwards Deliverect alert emails (e.g. "Order injection failed") to Telegram etc.
# Gmail: imap.gmail.com + App Password. Mailbox is read-only (emails stay unread).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_FROM_FILTER=deliverect
IMAP_POLL_SECONDS=60
IMAP_MAX_AGE_MINUTES=60

# Slack / Teams / Google Chat incoming webhooks (comma separated)
CHAT_WEBHOOK_URLS=

# Status mappings - verify against a real payload from your account
# From real payloads: 4/1 = order in, 2 = POS received (posOrderStatus 10), 20 accepted, 50 preparing, 90 finalized
DELIVERECT_RECEIVED_STATUSES=1,4
DELIVERECT_ACK_STATUSES=2,20,40,50,60,70,80,85,86,90,95
# Per Deliverect docs: 120 Failed, 121 POS Failed, 122 Retry Failed, 124 Parse Failed
DELIVERECT_FAILED_STATUSES=120,121,122,124
DELIVERECT_CANCEL_STATUSES=100,110
URBANPIPER_RECEIVED_STATES=PLACED
URBANPIPER_ACK_STATES="ACKNOWLEDGED,FOOD READY,DISPATCHED,COMPLETED"
URBANPIPER_FAILED_STATES=FAILED
URBANPIPER_CANCEL_STATES=CANCELLED
